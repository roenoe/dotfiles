# This is an example of how you can manage your monitors. Copy this file to ./monitors.conf to use it.

# See `man sway-output`
# See `swaymsg -t get_outputs` for monitor names and capabilities

# Examples
#output [NAME] resolution [RESOLUTION]@[FRAMERATE]Hz position [X-AXIS],[Y-AXIS] transform [0|90|180|270]

# IMPORTANT!! Don't use negative numbers for any of your monitors. This will break xwayland windows in those places.
#output DP-1 resolution 5120x2160@75Hz position 0,300
#output DP-2 resolution 2560x1440 position 5120,0 transform 270
#output DP-3 resolution 2560x1440 position 5280,0 transform 270

# Workspaces
# See `man 5 sway`
workspace 1 output DP-1
workspace 2 output DP-1
workspace 3 output DP-1
workspace 4 output DP-1
workspace 5 output DP-1
workspace 6 output DP-1
workspace 7 output DP-1
workspace 8 output DP-1
workspace 9 output DP-1
workspace 10 output DP-1
workspace 11 output DP-1
workspace 12 output DP-1
workspace display2 output DP-2
